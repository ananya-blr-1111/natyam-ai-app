{
  "expo": {
    "name": "NatyamAnalyzer",
    "slug": "natyamai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "natyamanalyzer",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.natyamai.analyzer",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.natyamai.analyzer",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#faf6ee",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#faf6ee",
          "dark": {
            "backgroundColor": "#faf6ee"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a7fea6d-93b0-40bf-b3d5-e430abdfa225"
      }
    },
    "owner": "ananya67"
  }
}
